# Jeton secret fourni par @BotFather
BOT_TOKEN=123456789:remplacez_par_le_token_secret

# Identifiant numérique du supergroupe (commence généralement par -100)
TARGET_CHAT_ID=-1001234567890

# Identifiants autorisés à ouvrir le panneau, séparés par des virgules
ADMIN_IDS=123456789,987654321

# Lien principal affiché quand l'ouverture automatique est désactivée
GROUP_INVITE_LINK=https://t.me/+remplacez_ce_lien

# Ne pas modifier si le groupe suit l'heure française
TZ=Europe/Paris

# Montez un volume Railway sur /data pour conserver ces données
DATABASE_PATH=/data/bot.sqlite3

LOG_LEVEL=INFO

